{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["node"],
    "incremental": true,
    /* NEW LOGIC: 
      - Đã xóa bỏ "ignoreDeprecations" để tránh crash khi deploy.
      - Đã xóa bỏ hoàn toàn "baseUrl" để sửa lỗi gạch đỏ ở VS Code.
    */
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/components/ui/*": [
        "./components/ui/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/app/*": [
        "./app/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "./*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "workers"
  ]
}